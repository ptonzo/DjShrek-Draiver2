<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DjShrek-Draiver</AssemblyName>
    <RootNamespace>DjShrek.Draiver.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\DjShrek-Draiver.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <Product>DjShrek-Draiver Cyber Club</Product>
    <Company>DjShrek-Draiver</Company>
    <Description>Windows device inventory and driver maintenance utility</Description>
  </PropertyGroup>
</Project>