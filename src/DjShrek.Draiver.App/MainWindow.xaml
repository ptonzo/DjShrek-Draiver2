<Window x:Class="DjShrek.Draiver.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DjShrek-Draiver Cyber Club" Height="780" Width="1240" MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#0B1020" Foreground="#F2F6FF">
 <Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#101A2D" BorderBrush="#263653" BorderThickness="0,0,0,1"><Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="DjShrek-Draiver" FontSize="25" FontWeight="Bold"/><TextBlock Text="CYBER CLUB  •  PC CONTROL CENTER" Foreground="#39B8FF" FontSize="10" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Fill="#35D49A" Margin="0,0,9,0"/><TextBlock Text="ЛОКАЛЬНЫЙ РЕЖИМ" Foreground="#9BAAC4" VerticalAlignment="Center"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1" Margin="22,18"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#121B30" CornerRadius="12" Padding="12" Margin="0,0,18,0"><StackPanel>
    <TextBlock Text="РАЗДЕЛЫ" Foreground="#7185A8" FontWeight="Bold" FontSize="10" Margin="8,8,0,14"/>
    <Button Content="◈  Обзор системы" Click="Dashboard_Click" HorizontalContentAlignment="Left" Background="#203451"/>
    <Button Content="▦  Устройства" Click="Devices_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
    <Button Content="↻  Драйверы и backup" Click="Drivers_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
    <Button Content="⚙  Диагностика" Click="Diagnostics_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
    <Separator Margin="4,18" Background="#263653"/><TextBlock Text="ИНФОРМАЦИЯ" Foreground="#7185A8" FontWeight="Bold" FontSize="10" Margin="8,4,0,10"/>
    <TextBlock Text="Версия 1.0.0" Foreground="#9BAAC4" Margin="8,0,0,6"/><TextBlock Text="Windows 10 / 11 x64" Foreground="#9BAAC4" Margin="8,0,0,6"/>
    <TextBlock Text="Системные операции выполняются штатными средствами Windows." Foreground="#7185A8" TextWrapping="Wrap" FontSize="11" Margin="8,18,8,0"/>
   </StackPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,2,0,16"><StackPanel><TextBlock x:Name="PageTitle" Text="Обзор системы" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Состояние компьютера и инструменты обслуживания" Foreground="#9BAAC4" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="⟳  Обновить данные" Click="Refresh_Click" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="1">
     <Grid x:Name="DashboardPanel"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="#121B30" CornerRadius="12" Padding="18" Margin="0,0,10,14"><StackPanel><TextBlock Text="ЗАГРУЗКА CPU" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CpuValue" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Последнее измерение" Foreground="#7185A8" FontSize="10"/></StackPanel></Border>
       <Border Grid.Column="1" Background="#121B30" CornerRadius="12" Padding="18" Margin="0,0,10,14"><StackPanel><TextBlock Text="ПАМЯТЬ" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Использование RAM" Foreground="#7185A8" FontSize="10"/></StackPanel></Border>
       <Border Grid.Column="2" Background="#121B30" CornerRadius="12" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="УСТРОЙСТВА" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DeviceCount" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Обнаружено Windows" Foreground="#7185A8" FontSize="10"/></StackPanel></Border>
      </Grid>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="ОПЕРАЦИОННАЯ СИСТЕМА" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="OsValue" Text="Получение сведений..." FontSize="17" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Background="#121B30" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold" Margin="0,0,0,14"/><WrapPanel><Button Content="Сканировать устройства" Click="Scan_Click"/><Button Content="Резервная копия драйверов" Click="Backup_Click"/><Button Content="Выбрать INF для установки" Click="Install_Click"/></WrapPanel><TextBlock Text="Установка требует подтверждения UAC. Windows проверяет подписи и применимость пакета." Foreground="#7185A8" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"/></StackPanel></Border>
     </StackPanel></ScrollViewer></Grid>
     <Grid x:Name="DevicesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Список PnP-устройств Windows" Foreground="#9BAAC4" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Сканировать" Click="Scan_Click"/></DockPanel><DataGrid x:Name="DevicesGrid" Grid.Row="1" AlternationCount="2"/></Grid>
     <Grid x:Name="DriversPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Обслуживание драйверов" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="РЕЗЕРВНОЕ КОПИРОВАНИЕ" Foreground="#39B8FF" FontWeight="Bold" FontSize="11"/><TextBlock Text="Экспорт пакетов драйверов из Driver Store штатной командой pnputil." TextWrapping="Wrap" Foreground="#C4D0E4" Margin="0,8,0,14"/><Button Content="Экспортировать драйверы" HorizontalAlignment="Left" Click="Backup_Click"/></StackPanel></Border>
      <Border Background="#121B30" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="УСТАНОВКА INF-ПАКЕТА" Foreground="#39B8FF" FontWeight="Bold" FontSize="11"/><TextBlock Text="Выберите INF-файл из доверенного источника. Проверьте производителя и совместимость. Windows может запросить права администратора." TextWrapping="Wrap" Foreground="#C4D0E4" Margin="0,8,0,14"/><Button Content="Выбрать INF и установить" HorizontalAlignment="Left" Click="Install_Click"/></StackPanel></Border>
     </StackPanel></Grid>
     <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Диагностика" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/><Border Background="#121B30" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Инвентаризация Plug and Play" FontWeight="Bold"/><TextBlock Text="Читает Win32_PnPEntity: название, класс, состояние, Instance ID и код конфигурации. Сканирование не изменяет систему." Foreground="#C4D0E4" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="Запустить проверку" HorizontalAlignment="Left" Click="Scan_Click"/></StackPanel></Border></StackPanel></Grid>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#101A2D"><DockPanel Margin="22,0"><TextBlock x:Name="StatusText" Text="Готово" Foreground="#9BAAC4" VerticalAlignment="Center"/><TextBlock Text="DjShrek-Draiver • Независимый проект" Foreground="#7185A8" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>