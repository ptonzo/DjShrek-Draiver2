<Window x:Class="DjShrek.Draiver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:DjShrek.Draiver.App.Services"
        xmlns:controls="clr-namespace:DjShrek.Draiver.App.Controls"
        Title="DjShrek-Draiver Cyber Club"
        Height="940" Width="1640" MinHeight="820" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="23"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="DS" FontSize="17" FontWeight="Black"
                               Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="DjShrek-Draiver Cyber Club" FontSize="24" FontWeight="Black"/>
                    <TextBlock Text="PC CONTROL CENTER" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource AccentSecondaryBrush}" Margin="1,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ТЕМА ОФОРМЛЕНИЯ" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ThemeSelector" Width="300" Height="38"
                              ItemsSource="{x:Static services:ThemeManager.Themes}"
                              DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectionChanged="ThemeSelector_SelectionChanged"
                              />
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" Margin="18,0,8,0"/>
                    <TextBlock Text="ЛОКАЛЬНЫЙ РЕЖИМ" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource NavigationBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="13" Padding="12" Margin="0,0,16,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="РАЗДЕЛЫ ПРОГРАММЫ" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}" Margin="10,9,0,17"/>
                        <Button x:Name="DashboardNavButton" Content="Главная" Click="Dashboard_Click"
                                HorizontalContentAlignment="Left" Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentSecondaryBrush}" Margin="0,0,0,7"/>
                        <Button x:Name="DevicesNavButton" Content="Драйверы и устройства" Click="Devices_Click"
                                HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,7"/>
                        <Button x:Name="UpdatesNavButton" Content="Обновления драйверов" Click="Drivers_Click"
                                HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,7"/>
                        <Button x:Name="RegistryNavButton" Content="Проверка реестра" Click="Registry_Click"
                                HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,7"/>
                        <Button x:Name="CleanupNavButton" Content="Очистка компьютера" Click="Cleanup_Click"
                                HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,7"/>
                        <Button x:Name="SettingsNavButton" Content="Настройки" Click="Settings_Click"
                                HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="0,0,0,7"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,18,8,6">
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,13"/>
                        <TextBlock Text="DJSHREK CYBER CLUB" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentSecondaryBrush}"/>
                        <TextBlock Text="Версия 1.7.0" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,4"/>
                        <TextBlock Text="Windows 10 / 11 x64" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="Установка драйверов выполняется только после проверки пакета и отдельного подтверждения."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Главная" FontSize="25" FontWeight="Bold"/>
                        <TextBlock x:Name="PageSubtitle" Text="Мониторинг компьютера и инструменты обслуживания"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Обновить мониторинг"
                            Click="Refresh_Click" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid x:Name="DashboardPanel" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{DynamicResource HeroBrush}" CornerRadius="14"
                                        Padding="22" Margin="0,0,0,14" MinHeight="190"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="350"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="DJSHREK CYBER CLUB" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                            <TextBlock Text="Добро пожаловать в DjShrek-Draiver!" FontSize="25"
                                                       FontWeight="Black" Margin="0,5,0,4"/>
                                            <TextBlock Text="Ваш ПК под контролем — мониторинг, драйверы и обслуживание в одном центре."
                                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                            <WrapPanel Margin="0,15,0,0">
                                                <Button Content="Сканировать устройства" Click="Scan_Click"/>
                                                <Button Content="Найти драйверы" Click="AutoUpdateDrivers_Click"
                                                        Background="{DynamicResource AccentSecondaryBrush}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <controls:ThemeArtwork x:Name="HeroArtwork" Grid.Column="1" Width="340" Height="170"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="15" Margin="0,0,9,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="CPU" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock x:Name="CpuValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,7,0,5"/>
                                            <ProgressBar x:Name="CpuProgress" Value="0"/>
                                            <TextBlock Text="Загрузка процессора" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="15" Margin="0,0,9,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="GPU" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock x:Name="GpuValue" Text="Н/Д" FontSize="29" FontWeight="Bold" Margin="0,7,0,5"/>
                                            <ProgressBar x:Name="GpuProgress" Value="0"/>
                                            <TextBlock x:Name="GpuDetail" Text="Видеокарта" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="15" Margin="0,0,9,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="RAM" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock x:Name="MemoryValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,7,0,5"/>
                                            <ProgressBar x:Name="MemoryProgress" Value="0"/>
                                            <TextBlock x:Name="MemoryDetail" Text="Использование памяти" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="ДИСК C:" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock x:Name="DiskValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,7,0,5"/>
                                            <ProgressBar x:Name="DiskProgress" Value="0"/>
                                            <TextBlock x:Name="DiskDetail" Text="Использование системного диска" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" Margin="0,0,10,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="ОБОРУДОВАНИЕ И СИСТЕМА" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                            <TextBlock x:Name="OsValue" Text="Получение сведений о Windows..." FontSize="15" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                            <TextBlock x:Name="ComputerValue" Text="Определение модели компьютера..." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="CpuNameValue" Text="Процессор: —" Margin="0,10,0,0"/>
                                            <TextBlock x:Name="GpuNameValue" Text="Видеокарта: —" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="UptimeValue" Text="Время работы: —" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="ТЕМПЕРАТУРЫ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                            <TextBlock x:Name="CpuTempValue" Text="CPU  ·  Нет данных" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                            <TextBlock x:Name="GpuTempValue" Text="GPU  ·  Нет данных" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TemperatureNote" Text="Датчики доступны не на каждом оборудовании."
                                                       FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,0,0,12"/>
                                        <WrapPanel>
                                            <Button Content="Сканировать устройства" Click="Scan_Click"/>
                                            <Button Content="Резервная копия драйверов" Click="Backup_Click"/>
                                            <Button Content="Онлайн-поиск драйверов" Click="AutoUpdateDrivers_Click"/>
                                            <Button Content="Проверить реестр" Click="Registry_Click"/>
                                            <Button Content="Проверить временные файлы" Click="Cleanup_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="HealthSummary" Text="Выполните сканирование для проверки состояния устройств."
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="15" Margin="0,0,0,13"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ЖУРНАЛ СОБЫТИЙ" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,0,0,8"/>
                                        <ListBox x:Name="EventLogList" Height="112" Background="Transparent"
                                                 BorderThickness="0" Foreground="{DynamicResource MutedBrush}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Мониторинг обновляется автоматически. Если датчик недоступен, программа показывает «Нет данных», а не подставляет вымышленное значение."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="DevicesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="DeviceSearch" Width="310" Height="38" VerticalContentAlignment="Center"
                                         TextChanged="DeviceSearch_TextChanged"
                                         ToolTip="Поиск по имени, производителю, классу, драйверу и Hardware ID"/>
                                <CheckBox x:Name="ErrorsOnlyCheck" Content="Только проблемные устройства"
                                          Margin="14,0,0,0" Checked="DeviceFilter_Changed" Unchecked="DeviceFilter_Changed"/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="Сканировать" Click="Scan_Click"/>
                                <Button Content="Экспорт CSV" Click="ExportDevices_Click"/>
                                <Button Content="Резервная копия" Click="Backup_Click"/>
                                <Button Content="Восстановить" Click="RestoreDrivers_Click"/>
                                <Button Content="Сопоставить локальные INF" Click="MatchLocalDriverPackages_Click"/>
                                <Button Content="SHA-256 манифест пакетов" Click="CalculatePackageHashes_Click"/>
                                <Button Content="Загрузить официальный пакет" Click="DownloadOfficialPackage_Click"/>
                            </WrapPanel>
                        </DockPanel>
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="АНАЛИЗ СОСТОЯНИЯ ДРАЙВЕРОВ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Content="Обновить анализ" Click="RefreshDriverHealth_Click" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <TextBlock x:Name="DriverHealthSummaryText" Text="Сканируйте устройства для формирования отчёта." Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                <TextBlock x:Name="DriverHealthChangesText" Text="История изменений появится после первого анализа." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,9"/>
                                <DataGrid x:Name="DriverHealthGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="100" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" Width="2*"/>
                                        <DataGridTextColumn Header="Приоритет" Binding="{Binding Severity}" Width="*"/>
                                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
                                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="3*"/>
                                        <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation}" Width="3*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="DevicesGrid" Grid.Row="1" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Устройство" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="*"/>
                                <DataGridTextColumn Header="Класс" Binding="{Binding Class}" Width="*"/>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="*"/>
                                <DataGridTextColumn Header="Код ошибки" Binding="{Binding Problem}" Width="*"/>
                                <DataGridTextColumn Header="Поставщик" Binding="{Binding DriverProvider}" Width="*"/>
                                <DataGridTextColumn Header="Версия драйвера" Binding="{Binding DriverVersion}" Width="*"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding DriverDate}" Width="*"/>
                                <DataGridTextColumn Header="INF" Binding="{Binding InfName}" Width="*"/>
                                <DataGridTextColumn Header="Подпись" Binding="{Binding Signature}" Width="*"/>
                                <DataGridTextColumn Header="Hardware ID" Binding="{Binding InstanceId}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="DriversPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{DynamicResource HeroBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,13"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ЦЕНТР ОБНОВЛЕНИЙ ДРАЙВЕРОВ" Foreground="{DynamicResource AccentSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Поиск совместимых драйверов для обнаруженного оборудования" FontSize="20" FontWeight="Bold" Margin="0,6,0,5"/>
                                        <TextBlock Text="Проверка выполняется по аппаратным идентификаторам. Перед установкой изучите список найденных пакетов."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,13,0,0">
                                            <Button Content="Сканировать и открыть SDIO" Click="AutoUpdateDrivers_Click"/>
                                            <Button Content="Поиск по Hardware ID в интернете" Click="SearchInternetCatalog_Click" Background="{DynamicResource AccentSecondaryBrush}"/>
                                            <Button Content="Каталоги производителей" Click="OpenOemCatalog_Click" Background="{DynamicResource AccentSecondaryBrush}"/>
                                        </WrapPanel>
                                        <TextBlock Text="ИМПОРТ СТРУКТУРИРОВАННОГО КАТАЛОГА OEM" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,15,0,7"/>
                                        <TextBlock Text="Загрузка JSON/XML-каталога производителя по официальному HTTPS-адресу с отбором записей по Hardware ID выбранного устройства." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <TextBox x:Name="StructuredCatalogVendorInput" Width="150" Margin="0,0,8,6" ToolTip="Производитель: ASUS, Dell, HP, Lenovo и т. д." Text="ASUS"/>
                                            <TextBox x:Name="StructuredCatalogUrlInput" Width="420" Margin="0,0,8,6" ToolTip="Официальный HTTPS URL JSON или XML каталога" />
                                            <Button Content="Загрузить каталог для выбранного устройства" Click="ImportStructuredCatalog_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="StructuredCatalogStatusText" Text="Выберите устройство в таблице оборудования и укажите официальный URL каталога." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="UpdatesCountText" Text="Поиск ещё не запускался." Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" Margin="0,0,0,13" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ПОСТОЯННЫЙ КАТАЛОГ ОБНОВЛЕНИЙ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="Кандидаты сохраняются между запусками. Здесь отображаются найденные пакеты, этап подготовки, версия, подпись и результат сопоставления с устройством."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                                        <WrapPanel>
                                            <Button Content="Обновить каталог" Click="RefreshDriverCatalog_Click"/>
                                            <Button Content="Удалить выбранную запись" Click="RemoveDriverCandidate_Click"/>
                                            <Button Content="Открыть манифест" Click="OpenDriverManifest_Click"/>
                                            <Button Content="Установить выбранный драйвер" Click="InstallSelectedCandidate_Click"/>
                                            <Button Content="Резервные копии" Click="RefreshBackupCatalog_Click"/>
                                            <Button Content="Проверить копию" Click="VerifyBackupCatalog_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="DriverCatalogSummaryText" Text="Каталог ещё не загружен." Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,8"/>
                                        <TextBlock Text="ИНТЕЛЛЕКТУАЛЬНЫЙ РЕЙТИНГ КАНДИДАТОВ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,12,0,7"/>
                                        <TextBlock Text="Оценка учитывает идентификаторы устройства, архитектуру, сборку Windows, подпись каталога и версию. Кандидаты с подтверждённой несовместимостью исключаются из подходящих." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <Button Content="Рассчитать рейтинг" Click="RefreshCandidateRanking_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="CandidateRankingSummaryText" Text="Рейтинг ещё не рассчитан." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,8"/>
                                        <DataGrid x:Name="CandidateRankingGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" SelectionMode="Single" MinHeight="140" MaxHeight="260">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Кандидат" Binding="{Binding Title}" Width="2*"/>
                                                <DataGridTextColumn Header="Баллы" Binding="{Binding Score}" Width="75"/>
                                                <DataGridTextColumn Header="Оценка" Binding="{Binding Confidence}" Width="100"/>
                                                <DataGridTextColumn Header="Совпадение" Binding="{Binding MatchType}" Width="*"/>
                                                <DataGridCheckBoxColumn Header="Допущен" Binding="{Binding IsEligible}" Width="85"/>
                                                <DataGridTextColumn Header="Причины" Binding="{Binding ReasonsText}" Width="3*"/>
                                                <DataGridTextColumn Header="Предупреждения" Binding="{Binding WarningsText}" Width="3*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="СРАВНЕНИЕ КАНДИДАТОВ И ДОВЕРИЯ К ИСТОЧНИКАМ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,14,0,7"/>
                                        <TextBlock Text="Сводная оценка сохранённых источников для выбранного устройства: совместимость, официальный домен, подпись, версия и дубликаты пакетов." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <WrapPanel><Button Content="Сравнить источники выбранного устройства" Click="CompareDriverSources_Click"/></WrapPanel>
                                        <TextBlock x:Name="SourceComparisonSummaryText" Text="Сравнение источников ещё не выполнялось." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,8"/>
                                        <DataGrid x:Name="SourceComparisonGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" SelectionMode="Single" MinHeight="130" MaxHeight="250">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Пакет" Binding="{Binding Title}" Width="2*"/>
                                                <DataGridTextColumn Header="Поставщик" Binding="{Binding Provider}" Width="*"/>
                                                <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="*"/>
                                                <DataGridTextColumn Header="Баллы" Binding="{Binding Score}" Width="65"/>
                                                <DataGridTextColumn Header="Доверие" Binding="{Binding SourceTrust}" Width="*"/>
                                                <DataGridCheckBoxColumn Header="Совместим" Binding="{Binding IsEligible}" Width="85"/>
                                                <DataGridTextColumn Header="Источников" Binding="{Binding DuplicateSourceCount}" Width="85"/>
                                                <DataGridTextColumn Header="Предупреждения" Binding="{Binding WarningsText}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <DataGrid x:Name="DriverCatalogGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" SelectionMode="Single" MinHeight="190" MaxHeight="330">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" Width="2*"/>
                                                <DataGridTextColumn Header="Производитель" Binding="{Binding Provider}" Width="*"/>
                                                <DataGridTextColumn Header="Текущая версия" Binding="{Binding InstalledVersion}" Width="*"/>
                                                <DataGridTextColumn Header="Кандидат" Binding="{Binding CandidateVersion}" Width="*"/>
                                                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*"/>
                                                <DataGridTextColumn Header="Подпись" Binding="{Binding SignatureStatus}" Width="*"/>
                                                <DataGridTextColumn Header="Совместимость" Binding="{Binding Compatibility}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="РЕЗЕРВНЫЕ КОПИИ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,15,0,7"/>
                                        <DataGrid x:Name="DriverBackupGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" SelectionMode="Single" MinHeight="100" MaxHeight="190">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                                                <DataGridTextColumn Header="Дата UTC" Binding="{Binding CreatedUtc}" Width="*"/>
                                                <DataGridTextColumn Header="Пакетов" Binding="{Binding PackageCount}" Width="90"/>
                                                <DataGridTextColumn Header="Размер, байт" Binding="{Binding TotalBytes}" Width="130"/>
                                                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="ЖУРНАЛ УСТАНОВОК ДРАЙВЕРОВ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,15,0,7"/>
                                        <TextBlock Text="Сохраняется история передачи пакетов Windows: устройство, версии, INF, результат команды и статус перезагрузки. Успешная команда pnputil сама по себе не подтверждает фактическую активацию драйвера."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <DataGrid x:Name="InstallationHistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  IsReadOnly="True" SelectionMode="Single" MinHeight="120" MaxHeight="260">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Время UTC" Binding="{Binding TimestampUtc}" Width="*"/>
                                                <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" Width="2*"/>
                                                <DataGridTextColumn Header="Старая версия" Binding="{Binding PreviousVersion}" Width="*"/>
                                                <DataGridTextColumn Header="Запрошенная версия" Binding="{Binding RequestedVersion}" Width="*"/>
                                                <DataGridTextColumn Header="Результат" Binding="{Binding Outcome}" Width="2*"/>
                                                <DataGridTextColumn Header="Перезагрузка" Binding="{Binding RebootStatus}" Width="*"/>
                                                <DataGridTextColumn Header="INF" Binding="{Binding InfPath}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" Margin="0,0,0,13" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ДВИЖОК ПОИСКА SDIO" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="Официальный Snappy Driver Installer Origin загружается по запросу, архив проверяется по SHA-256. Индексы обновляются внутри SDIO. Выбор и установка пакетов подтверждаются пользователем в окне движка."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                        <TextBlock Text="DjShrek-Draiver не использует Windows Update Agent, WUAPI или Microsoft Update Catalog."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" Margin="0,0,0,13" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ОФИЦИАЛЬНЫЕ ИНСТРУМЕНТЫ ПРОИЗВОДИТЕЛЕЙ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock x:Name="OemDetectText" Text="Определение производителя компьютера..." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                                        <TextBlock x:Name="OemIdentityText" Text="Получение расширенных идентификаторов модели..." Foreground="{DynamicResource AccentSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <Button Content="Открыть сайт производителя" Click="OpenDetectedOem_Click"/>
                                            <Button Content="Каталоги по модели и устройствам" Click="OpenModelCatalog_Click"/>
                                            <Button Content="Все каталоги" Click="OpenOemCatalog_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" Margin="0,0,0,13" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="РЕЗЕРВНОЕ КОПИРОВАНИЕ И ВОССТАНОВЛЕНИЕ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="Экспорт пакетов из Driver Store. Перед изменениями драйверов рекомендуется сохранить копию."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                        <WrapPanel>
                                            <Button Content="Экспортировать все драйверы" Click="Backup_Click"/>
                                            <Button Content="Восстановить из папки" Click="RestoreDrivers_Click"/>
                                            <Button Content="Установить INF вручную" Click="Install_Click"/>
                                            <Button Content="Список пакетов" Click="ListPackages_Click"/>
                                        </WrapPanel>
                                        <TextBox x:Name="PackagesText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 Height="180" Margin="0,12,0,0" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ИГРОВОЙ ПРОФИЛЬ WINDOWS" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="Включает Game Mode и схему высокой производительности с возможностью восстановления прежних настроек."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                        <WrapPanel>
                                            <Button Content="Включить игровой профиль" Click="EnableGameProfile_Click"/>
                                            <Button Content="Восстановить прежние настройки" Click="RestoreGameProfile_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="GameProfileText" Text="Профиль не активирован." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="RegistryPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="16" Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ДИАГНОСТИКА АВТОЗАПУСКА WINDOWS" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                    <TextBlock Text="Проверяются только стандартные разделы Run и RunOnce пользователя и системы. Сканирование ничего не изменяет. Перед удалением выбранной записи создаётся файл резервной копии .reg."
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Проверить реестр" Click="RegistryScan_Click"/>
                                        <Button Content="Исправить выбранную ошибку" Click="RegistryRepair_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="RegistrySummaryText" Text="Проверка ещё не запускалась." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <DataGrid x:Name="RegistryGrid" Grid.Row="1" AutoGenerateColumns="False"
                                  SelectionMode="Single" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Severity}" Width="110"/>
                                <DataGridTextColumn Header="Раздел" Binding="{Binding Hive}" Width="80"/>
                                <DataGridTextColumn Header="Ключ" Binding="{Binding SubKey}" Width="2*"/>
                                <DataGridTextColumn Header="Имя записи" Binding="{Binding ValueName}" Width="*"/>
                                <DataGridTextColumn Header="Данные запуска" Binding="{Binding ValueData}" Width="2*"/>
                                <DataGridTextColumn Header="Результат проверки" Binding="{Binding Issue}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="CleanupPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="18" Margin="0,0,0,12"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="БЕЗОПАСНАЯ ОЧИСТКА ВРЕМЕННЫХ ФАЙЛОВ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                <TextBlock Text="Проверяются только временные папки Windows и текущего пользователя. В список попадают файлы старше 7 дней. Загрузки, документы, фотографии, профили браузеров и личные данные не затрагиваются."
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                <WrapPanel>
                                    <Button Content="Быстрая проверка" Click="JunkScan_Click"/>
                                    <Button Content="Очистить выбранное" Click="JunkClean_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="JunkSummaryText" Text="Проверка ещё не запускалась." Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="JunkGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Extended" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Удалить" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn Header="Изменён" Binding="{Binding ModifiedText}" IsReadOnly="True" Width="150"/>
                                <DataGridTextColumn Header="Путь" Binding="{Binding Path}" IsReadOnly="True" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{DynamicResource HeroBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,14"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ПЕРСОНАЛИЗАЦИЯ DJSHREK" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Text="Настрой внешний вид программы" FontSize="22" FontWeight="Bold" Margin="0,6,0,4"/>
                                        <TextBlock Text="Выбранная тема сохраняется автоматически и применяется ко всем разделам."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="20" Margin="0,0,0,14"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="12 ТЕМ ОФОРМЛЕНИЯ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="Все темы меняют цвета фона, панелей, навигации, карточек, таблиц и кнопок. Переключение не меняет функции программы."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                        <ComboBox x:Name="SettingsThemeSelector" ItemsSource="{x:Static services:ThemeManager.Themes}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                                  SelectionChanged="SettingsThemeSelector_SelectionChanged" Width="450"
                                                  HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="20" Margin="0,0,0,14"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ЯЗЫК ИНТЕРФЕЙСА" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="Основной язык программы — русский. Доступен переключатель на английский для основных элементов навигации."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                        <ComboBox x:Name="LanguageSelector" Width="300" HorizontalAlignment="Left"
                                                  SelectionChanged="LanguageSelector_SelectionChanged">
                                            <ComboBoxItem Content="Русский" Tag="ru"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="Deutsch" Tag="de"/>
                                            <ComboBoxItem Content="Français" Tag="fr"/>
                                            <ComboBoxItem Content="Español" Tag="es"/>
                                            <ComboBoxItem Content="Português (Brasil)" Tag="pt_BR"/>
                                            <ComboBoxItem Content="Italiano" Tag="it"/>
                                            <ComboBoxItem Content="Polski" Tag="pl"/>
                                            <ComboBoxItem Content="Türkçe" Tag="tr"/>
                                            <ComboBoxItem Content="Українська" Tag="uk"/>
                                            <ComboBoxItem Content="简体中文" Tag="zh_CN"/>
                                            <ComboBoxItem Content="日本語" Tag="ja"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="20"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ИНФОРМАЦИЯ О ПРОГРАММЕ" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="DjShrek-Draiver Cyber Club 1.6.0" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5"/>
                                        <TextBlock Text="Windows 10 / 11 x64 · .NET 8 · локальный режим"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Программа не удаляет системные компоненты и не устанавливает драйверы без подтверждения пользователя."
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0">
                <TextBlock x:Name="StatusText" Text="Готово" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ThemeStatusText" Text="Тема: 01 · Игровой Neon Gaming"
                           Foreground="{DynamicResource AccentSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Startup scan screen: the main workspace remains covered until the user starts the scan. -->
        <Grid x:Name="StartupScanOverlay" Grid.RowSpan="3" Panel.ZIndex="100"
              Background="{DynamicResource AppBackgroundBrush}" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="560">
                <TextBlock Text="DJSHREK · CYBER CLUB" FontSize="15" FontWeight="Black"
                           Foreground="{DynamicResource AccentSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <Button x:Name="StartScanButton" Click="StartScan_Click"
                        Width="360" Height="360" HorizontalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        Cursor="Hand" ToolTip="Нажмите, чтобы начать сканирование устройств и драйверов">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="#10131B" Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"/>
                                <Ellipse Margin="13" Fill="#202633" Stroke="{DynamicResource AccentSecondaryBrush}" StrokeThickness="2"/>
                                <Ellipse Margin="27" Fill="#0B0E14" Stroke="#586174" StrokeThickness="2"/>
                                <Ellipse Margin="42" Fill="#1C2430" Stroke="#394657" StrokeThickness="1"/>
                                <Ellipse Margin="56" Fill="#111720" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                <Ellipse Width="190" Height="190" Stroke="#526071" StrokeThickness="1"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="150" Height="150" Stroke="#526071" StrokeThickness="1"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="110" Height="110" Stroke="#526071" StrokeThickness="1"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="72" Height="72" Fill="{DynamicResource AccentBrush}"
                                         Stroke="{DynamicResource AccentSecondaryBrush}" StrokeThickness="3"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="13" Height="13" Fill="#F4F6FA"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="#D90B1018" CornerRadius="14" Padding="24,14"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,35">
                                    <TextBlock Text="СКАНИРОВАТЬ" FontSize="25" FontWeight="Black"
                                               Foreground="White" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Нажмите на DJ-тарелку, чтобы проверить устройства и найти актуальные драйверы"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="15"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,22,0,0"/>
                <TextBlock Text="Установка найденных обновлений — только после вашего подтверждения"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>