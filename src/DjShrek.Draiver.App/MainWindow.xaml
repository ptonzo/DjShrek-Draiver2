<Window x:Class="DjShrek.Draiver.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DjShrek-Draiver Cyber Club" Height="820" Width="1360" MinHeight="680" MinWidth="1050" WindowStartupLocation="CenterScreen" Background="#0B1020" Foreground="#F2F6FF">
 <Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#101A2D" BorderBrush="#263653" BorderThickness="0,0,0,1"><Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="DjShrek-Draiver" FontSize="25" FontWeight="Bold"/><TextBlock Text="CYBER CLUB  •  PC CONTROL CENTER" Foreground="#39B8FF" FontSize="10" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Fill="#35D49A" Margin="0,0,9,0"/><TextBlock Text="ЛОКАЛЬНЫЙ РЕЖИМ" Foreground="#9BAAC4" VerticalAlignment="Center"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1" Margin="22,18"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#121B30" CornerRadius="12" Padding="12" Margin="0,0,18,0"><StackPanel>
    <TextBlock Text="РАЗДЕЛЫ" Foreground="#7185A8" FontWeight="Bold" FontSize="10" Margin="8,8,0,14"/>
    <Button Content="◈  Обзор системы" Click="Dashboard_Click" HorizontalContentAlignment="Left" Background="#203451"/>
    <Button Content="▦  Устройства" Click="Devices_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
    <Button Content="↻  Драйверы и backup" Click="Drivers_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
    <Button Content="⚙  Диагностика" Click="Diagnostics_Click" HorizontalContentAlignment="Left" Background="Transparent"/>
    <Separator Margin="4,18" Background="#263653"/><TextBlock Text="ИНФОРМАЦИЯ" Foreground="#7185A8" FontWeight="Bold" FontSize="10" Margin="8,4,0,10"/>
    <TextBlock Text="Версия 1.3.0" Foreground="#9BAAC4" Margin="8,0,0,6"/><TextBlock Text="Windows 10 / 11 x64" Foreground="#9BAAC4" Margin="8,0,0,6"/>
    <TextBlock Text="Используются системные механизмы Windows. Установка драйверов требует отдельного подтверждения." Foreground="#7185A8" TextWrapping="Wrap" FontSize="11" Margin="8,18,8,0"/>
   </StackPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,2,0,16"><StackPanel><TextBlock x:Name="PageTitle" Text="Обзор системы" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Состояние компьютера и инструменты обслуживания" Foreground="#9BAAC4" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="⟳  Обновить данные" Click="Refresh_Click" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="1">
     <Grid x:Name="DashboardPanel"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="#121B30" CornerRadius="12" Padding="18" Margin="0,0,10,14"><StackPanel><TextBlock Text="ЗАГРУЗКА CPU" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CpuValue" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Последнее измерение" Foreground="#7185A8" FontSize="10"/></StackPanel></Border>
       <Border Grid.Column="1" Background="#121B30" CornerRadius="12" Padding="18" Margin="0,0,10,14"><StackPanel><TextBlock Text="ПАМЯТЬ" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Использование RAM" Foreground="#7185A8" FontSize="10"/></StackPanel></Border>
       <Border Grid.Column="2" Background="#121B30" CornerRadius="12" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="УСТРОЙСТВА" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DeviceCount" Text="—" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Обнаружено Windows" Foreground="#7185A8" FontSize="10"/></StackPanel></Border>
      </Grid>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="ОПЕРАЦИОННАЯ СИСТЕМА" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="OsValue" Text="Получение сведений..." FontSize="17" Margin="0,8,0,0"/><TextBlock x:Name="ComputerValue" Text="Определение модели компьютера..." Foreground="#9BAAC4" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#121B30" CornerRadius="12" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="ТЕМПЕРАТУРА CPU" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CpuTempValue" Text="Нет данных" FontSize="24" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#121B30" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="ТЕМПЕРАТУРА GPU" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="GpuTempValue" Text="Нет данных" FontSize="24" Margin="0,8,0,0"/></StackPanel></Border></Grid><TextBlock x:Name="TemperatureNote" Text="Данные аппаратных датчиков" Foreground="#9BAAC4" Margin="0,0,0,12"/>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold" Margin="0,0,0,14"/><WrapPanel><Button Content="Сканировать устройства" Click="Scan_Click"/><Button Content="Резервная копия драйверов" Click="Backup_Click"/><Button Content="Проверить обновления Windows" Click="WindowsUpdate_Click"/></WrapPanel><TextBlock Text="Поиск и установка доступных драйверов выполняются через официальный механизм Windows Update. Приложение не подменяет драйверы сторонними пакетами." Foreground="#7185A8" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"/></StackPanel></Border>
      <Border Background="#121B30" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="СОСТОЯНИЕ УСТРОЙСТВ" Foreground="#9BAAC4" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HealthSummary" Text="Нажмите «Сканировать устройства» для проверки кодов ошибок." Foreground="#C4D0E4" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
     </StackPanel></ScrollViewer></Grid>
     <Grid x:Name="DevicesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><TextBox x:Name="DeviceSearch" Width="300" Height="34" VerticalContentAlignment="Center" Padding="8" TextChanged="DeviceSearch_TextChanged" ToolTip="Поиск по устройству, производителю, драйверу или Instance ID"/><CheckBox x:Name="ErrorsOnlyCheck" Content="Только с ошибками" Margin="14,0,0,0" VerticalAlignment="Center" Checked="DeviceSearch_TextChanged" Unchecked="DeviceSearch_TextChanged" Foreground="#C4D0E4"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Экспорт CSV" Click="ExportDevices_Click"/><Button Content="Сканировать" Click="Scan_Click"/></StackPanel></DockPanel><DataGrid x:Name="DevicesGrid" Grid.Row="1" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Устройство" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn IsReadOnly="True" Header="Производитель" Binding="{Binding Manufacturer}" Width="*"/><DataGridTextColumn IsReadOnly="True" Header="Класс" Binding="{Binding Class}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Код ошибки" Binding="{Binding Problem}" Width="*"/><DataGridTextColumn Header="Поставщик драйвера" Binding="{Binding DriverProvider}" Width="*"/><DataGridTextColumn Header="Версия" Binding="{Binding DriverVersion}" Width="*"/><DataGridTextColumn IsReadOnly="True" Header="Дата" Binding="{Binding DriverDate}" Width="*"/><DataGridTextColumn Header="INF" Binding="{Binding InfName}" Width="*"/><DataGridTextColumn Header="Подпись" Binding="{Binding Signature}" Width="*"/><DataGridTextColumn Header="Instance ID" Binding="{Binding InstanceId}" Width="3*"/></DataGrid.Columns></DataGrid></Grid>
     <Grid x:Name="DriversPanel" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Обслуживание драйверов" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="ЦЕНТР ОБНОВЛЕНИЙ ДРАЙВЕРОВ" Foreground="#39B8FF" FontWeight="Bold" FontSize="11"/><TextBlock Text="Автоматический режим сканирует совместимые обновления Microsoft Windows Update, показывает найденные пакеты, затем после вашего подтверждения скачивает и устанавливает их системным механизмом Windows." TextWrapping="Wrap" Foreground="#C4D0E4" Margin="0,8,0,12"/><WrapPanel><Button Content="Автоматически найти, скачать и установить" Click="AutoUpdateDrivers_Click" FontWeight="Bold"/><Button Content="Найти обновления вручную" Click="SearchWindowsDriverUpdates_Click"/><Button Content="Установить найденные обновления" Click="InstallWindowsDriverUpdates_Click"/></WrapPanel><TextBlock x:Name="UpdatesCountText" Text="Список ещё не проверялся." Foreground="#9BAAC4" Margin="0,10,0,8"/><DataGrid x:Name="UpdatesGrid" AutoGenerateColumns="False" IsReadOnly="False" Height="220"><DataGrid.Columns><DataGridCheckBoxColumn Header="Включить" IsReadOnly="False" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="75"/><DataGridTextColumn IsReadOnly="True" Header="Драйвер / пакет" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn IsReadOnly="True" Header="Производитель" Binding="{Binding Manufacturer}" Width="*"/><DataGridTextColumn IsReadOnly="True" Header="Модель" Binding="{Binding Model}" Width="*"/><DataGridTextColumn IsReadOnly="True" Header="Поставщик" Binding="{Binding Provider}" Width="*"/><DataGridTextColumn IsReadOnly="True" Header="Класс" Binding="{Binding DriverClass}" Width="*"/><DataGridTextColumn IsReadOnly="True" Header="ID обновления" Binding="{Binding UpdateId}" Width="2*"/><DataGridTextColumn IsReadOnly="True" Header="Дата" Binding="{Binding DriverDate}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="ОБНОВЛЕНИЯ ДРАЙВЕРОВ" Foreground="#39B8FF" FontWeight="Bold" FontSize="11"/><TextBlock Text="Открывает официальный раздел необязательных обновлений Windows. Доступность драйверов зависит от производителя оборудования, модели ПК и политики Windows Update." TextWrapping="Wrap" Foreground="#C4D0E4" Margin="0,8,0,14"/><Button Content="Открыть обновления драйверов Windows" HorizontalAlignment="Left" Click="WindowsUpdate_Click"/></StackPanel></Border>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="РЕЗЕРВНОЕ КОПИРОВАНИЕ" Foreground="#39B8FF" FontWeight="Bold" FontSize="11"/><TextBlock Text="Экспорт установленных пакетов драйверов из Driver Store в выбранную папку. Рекомендуется выполнить перед обслуживанием системы." TextWrapping="Wrap" Foreground="#C4D0E4" Margin="0,8,0,14"/><WrapPanel><Button Content="Экспортировать драйверы" Click="Backup_Click"/><Button Content="Восстановить из папки backup" Click="RestoreDrivers_Click"/></WrapPanel></StackPanel></Border>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="УСТАНОВКА INF-ПАКЕТА" Foreground="#39B8FF" FontWeight="Bold" FontSize="11"/><TextBlock Text="Выберите INF-файл из доверенного источника. Проверьте производителя и совместимость. Windows может запросить права администратора." TextWrapping="Wrap" Foreground="#C4D0E4" Margin="0,8,0,14"/><Button Content="Выбрать INF и установить" HorizontalAlignment="Left" Click="Install_Click"/></StackPanel></Border>
      <Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="ОФИЦИАЛЬНЫЕ КАТАЛОГИ ДРАЙВЕРОВ" Foreground="#39B8FF" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="OemDetectText" Text="Определение производителя компьютера..." Foreground="#C4D0E4" Margin="0,8,0,10" TextWrapping="Wrap"/><WrapPanel><Button Content="Каталог производителя ПК" Click="OpenDetectedOem_Click"/><Button Content="Все каталоги" Click="OpenOemCatalog_Click"/></WrapPanel></StackPanel></Border><Border Background="#121B30" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="УСТАНОВЛЕННЫЕ ПАКЕТЫ DRIVER STORE" Foreground="#39B8FF" FontWeight="Bold" FontSize="11"/><Button Content="Обновить список пакетов" HorizontalAlignment="Left" Margin="0,10,0,10" Click="ListPackages_Click"/><TextBox x:Name="PackagesText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="190" Background="#0B1020" Foreground="#C4D0E4" BorderBrush="#263653" FontFamily="Consolas"/></StackPanel></Border>
     </StackPanel></ScrollViewer></Grid>
     <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="Диагностика" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/><Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="ПРОВЕРКА PLUG AND PLAY" FontWeight="Bold"/><TextBlock Text="Сканирование устройств, кодов конфигурации и состояния драйверов. Отчёт можно экспортировать в CSV." Foreground="#C4D0E4" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="Запустить полную проверку" HorizontalAlignment="Left" Click="Scan_Click"/></StackPanel></Border><Border Background="#121B30" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="ИГРОВОЙ ПРОФИЛЬ WINDOWS" FontWeight="Bold"/><TextBlock Text="Включает Windows Game Mode и план высокой производительности. Сохраняет исходные настройки для восстановления. Не отключает системные службы и процессы." Foreground="#C4D0E4" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button Content="Включить игровой профиль" Click="EnableGameProfile_Click"/><Button Content="Восстановить настройки" Click="RestoreGameProfile_Click"/></WrapPanel><TextBlock x:Name="GameProfileText" Text="Профиль не активирован." Foreground="#9BAAC4" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#121B30" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="ОБНОВЛЕНИЯ WINDOWS" FontWeight="Bold"/><TextBlock Text="Проверка доступных драйверов выполняется средствами Microsoft Windows Update." Foreground="#C4D0E4" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="Перейти к необязательным обновлениям" HorizontalAlignment="Left" Click="WindowsUpdate_Click"/></StackPanel></Border></StackPanel></Grid>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#101A2D"><DockPanel Margin="22,0"><TextBlock x:Name="StatusText" Text="Готово" Foreground="#9BAAC4" VerticalAlignment="Center"/><TextBlock Text="DjShrek-Draiver • Независимый проект" Foreground="#7185A8" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>